# StockMaster 3000 – Reverse Proxy. Standard: nur Heimnetz (private Adressbereiche),
# HTTPS mit lokaler Zertifizierungsstelle. Siehe webui/BETRIEB.md.
{
	admin off
	http_port 8080
	https_port 8443
	local_certs
	skip_install_trust
	# Zertifikat für Clients ohne Servernamen (SNI), z. B. Browser bei einer IP-Adresse in der URL. Hinter
	# Docker ist die lokale Adresse die des Containers; ohne diese Vorgabe scheitert der TLS-Handshake.
	# proxy-start.sh setzt die Werte aus SM_HOSTNAME und SM_ZUSAETZLICHE_HOSTS.
	default_sni {$SM_SNI_STANDARD:stockmaster.local}
	servers {
		# Die echte Client-Adresse wird nicht aus Headern übernommen.
		trusted_proxies static 127.0.0.1/32
	}
}

# Hauptname, localhost (Healthcheck) und optional weitere Namen oder IP-Adressen (SM_ZUSAETZLICHE_HOSTS).
{$SM_HOSTNAME:stockmaster.local} localhost {$SM_HOSTS_ZUSATZ:} {
	tls internal

	# Anfragen sind klein; nur das Hochladen einer Sicherung (Wiederherstellung, nur Admin) darf groß sein.
	@wiederherstellung path /api/sicherung/wiederherstellen
	request_body @wiederherstellung {
		max_size 1024MB
	}
	@normal not path /api/sicherung/wiederherstellen
	request_body @normal {
		max_size 64KB
	}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		-Server
	}

	# route erhält die Reihenfolge: zuerst die Heimnetz-Schranke, dann API und SPA.
	route {
		# Zugriff nur aus privaten Netzen (zusätzliche Netze, z. B. VPN, über SM_ZUSAETZLICHE_NETZE).
		@extern not remote_ip private_ranges {$SM_ZUSAETZLICHE_NETZE:127.0.0.1/32}
		respond @extern "Zugriff nur aus dem Heimnetz." 403

		handle /api/* {
			reverse_proxy api:8000
		}

		# Öffentliches Root-Zertifikat der lokalen CA zum Installieren auf den Geräten (nur Heimnetz).
		handle /stockmaster-root.crt {
			rewrite * /root.crt
			root * /data/caddy/pki/authorities/local
			header Content-Type "application/x-x509-ca-cert"
			header Content-Disposition `attachment; filename="stockmaster-root.crt"`
			file_server
		}

		handle {
			root * /srv
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			try_files {path} /index.html
			file_server
		}
	}
}

# Alles andere (unbekannte IP-Adresse in der URL): ein Hinweis statt einer leeren Seite. Für einen unbekannten
# Namen gibt es kein Zertifikat; dort scheitert schon der TLS-Handshake.
:8443 {
	tls internal

	# Wie oben: nur aus dem Heimnetz.
	@extern not remote_ip private_ranges {$SM_ZUSAETZLICHE_NETZE:127.0.0.1/32}
	respond @extern "Zugriff nur aus dem Heimnetz." 403

	header {
		Content-Type "text/plain; charset=utf-8"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}
	respond "Unbekannter Name oder unbekannte Adresse in der URL. Die Web-UI antwortet nur unter den konfigurierten Namen (SM_HOSTNAME, SM_ZUSAETZLICHE_HOSTS)." 421
}
