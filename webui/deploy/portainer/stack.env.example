# Umgebungsvariablen für den Portainer-Stack (in Portainer unter "Environment variables" einfügen).
# Passwörter dürfen beliebige Zeichen enthalten; lang und zufällig wählen (z. B. `openssl rand -base64 24`).

# Name im Heimnetz (DNS-Eintrag im Router oder /etc/hosts der Geräte)
SM_HOSTNAME=stockmaster.local
# Absoluter Pfad des Spiel-Repositorys auf dem Docker-Host (wird nur lesend eingebunden)
SPIEL_REPO=/srv/stockmaster/spiel-repo

# openssl rand -base64 24
POSTGRES_ADMIN_PASSWORD=
# openssl rand -base64 24  (anderer Wert!)
POSTGRES_APP_PASSWORD=
# openssl rand -base64 32  (verschlüsselt die Zwei-Faktor-Geheimnisse; sicher aufbewahren)
# Genau so einfügen: 44 Zeichen, das letzte ist ein '=', ohne Anführungszeichen und Leerzeichen.
SM_SCHLUESSEL=

# Optional
# Weitere Namen oder IP-Adressen, unter denen die Web-UI antwortet (Leerzeichen oder Komma, ohne Port).
# Ohne diese Angabe funktioniert nur SM_HOSTNAME; mit der IP des Servers auch https://192.168.2.187
# SM_ZUSAETZLICHE_HOSTS=192.168.2.187
# SM_HTTPS_PORT=443
# SM_HTTP_PORT=80
# SM_ZUSAETZLICHE_NETZE=100.64.0.0/10
# SM_IMAGE_PREFIX=ghcr.io/tenofnine/stockmaster3000
# SM_IMAGE_TAG=latest
