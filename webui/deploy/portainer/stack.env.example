# Umgebungsvariablen für den Portainer-Stack (in Portainer unter "Environment variables" einfügen).
# Werte mit `openssl rand` erzeugen; Passwörter nur Buchstaben/Ziffern (hex), sonst bricht die DB-URL.

# Name im Heimnetz (DNS-Eintrag im Router oder /etc/hosts der Geräte)
SM_HOSTNAME=stockmaster.local
# Absoluter Pfad des Spiel-Repositorys auf dem Docker-Host (wird nur lesend eingebunden)
SPIEL_REPO=/srv/stockmaster/spiel-repo

# openssl rand -hex 24
POSTGRES_ADMIN_PASSWORD=
# openssl rand -hex 24  (anderer Wert!)
POSTGRES_APP_PASSWORD=
# openssl rand -base64 32  (verschlüsselt die Zwei-Faktor-Geheimnisse; sicher aufbewahren)
SM_SCHLUESSEL=

# Optional
# SM_HTTPS_PORT=443
# SM_HTTP_PORT=80
# SM_ZUSAETZLICHE_NETZE=100.64.0.0/10
# SM_IMAGE_PREFIX=ghcr.io/tenofnine/stockmaster3000
# SM_IMAGE_TAG=latest
