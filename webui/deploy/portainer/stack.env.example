# Umgebungsvariablen für den Portainer-Stack (Portainer: "Environment variables"). Minimal: nur der Name.
# Keine Geheimnisse im Stack: DB-Passwörter und Master-Schlüssel erzeugt der Stack beim ersten Start
# selbst (Volumes), Claude-Token und Kurs-API-Keys trägt ein Admin in der App ein (Einrichtung).

# Name im Heimnetz (DNS-Eintrag im Router oder /etc/hosts der Geräte)
SM_HOSTNAME=stockmaster.local

# Optional
# Weitere Namen oder IP-Adressen (Leerzeichen oder Komma, ohne Port); mit der IP des Servers funktioniert
# auch https://192.168.2.187
# SM_ZUSAETZLICHE_HOSTS=192.168.2.187
# SM_HTTPS_PORT=443
# SM_HTTP_PORT=80
# SM_ZUSAETZLICHE_NETZE=100.64.0.0/10
# TZ=Europe/Berlin
# SM_IMAGE_PREFIX=ghcr.io/tenofnine/stockmaster3000
# SM_IMAGE_TAG=latest

# Nur bei einem Update einer älteren Installation EINMALIG stehen lassen, bis die Einrichtung meldet,
# dass sie übernommen wurden (danach entfernen):
# SM_SCHLUESSEL, POSTGRES_ADMIN_PASSWORD, POSTGRES_APP_PASSWORD, CLAUDE_CODE_OAUTH_TOKEN,
# FINNHUB_API_KEY, TWELVEDATA_API_KEY
