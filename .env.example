# Kopie als .env anlegen (webui/deploy/einrichten.sh macht das automatisch). Keine Geheimnisse hier –
# die liegen in ./secrets/ (Docker Secrets).

# Name, unter dem die Web-UI im Heimnetz erreichbar ist (DNS oder /etc/hosts der Geräte).
SM_HOSTNAME=stockmaster.local
# Pfad zum Spiel-Repository (wird nur lesend eingebunden). Standard: dieses Repository.
SPIEL_REPO=.
# Veröffentlichte Ports auf dem Host.
SM_HTTPS_PORT=443
SM_HTTP_PORT=80
# Zusätzliche Namen oder IP-Adressen, unter denen die Web-UI antwortet (Leerzeichen oder Komma, ohne Port),
# z. B. die IP des Servers, damit https://192.168.2.187 funktioniert. Standard: nur SM_HOSTNAME.
SM_ZUSAETZLICHE_HOSTS=
# Zusätzliche erlaubte Netze, z. B. ein VPN-Bereich (Leerzeichen-getrennt). Standard: nur private Netze.
SM_ZUSAETZLICHE_NETZE=127.0.0.1/32
# Registry-Spiegel für Basis-Images, falls Docker Hub drosselt (z. B. mirror.gcr.io/library).
REGISTRY=docker.io/library
