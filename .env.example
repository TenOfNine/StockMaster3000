# Minimale Start-Variablen (Kopie als .env anlegen). Keine Geheimnisse: DB-Passwörter und der
# Master-Schlüssel entstehen beim ersten Start in den Volumes; Claude-Token, Kurs-API-Keys, News und
# Zeitplan pflegt ein Admin in der App (Einrichtung).

# Name, unter dem die Web-UI im Heimnetz erreichbar ist (DNS oder /etc/hosts der Geräte).
SM_HOSTNAME=stockmaster.local

# Optional
# Weitere Namen oder IP-Adressen (Leerzeichen oder Komma, ohne Port), z. B. die IP des Servers.
SM_ZUSAETZLICHE_HOSTS=
# Zusätzliche erlaubte Netze, z. B. ein VPN-Bereich (Leerzeichen-getrennt). Standard: nur private Netze.
SM_ZUSAETZLICHE_NETZE=127.0.0.1/32
# Veröffentlichte Ports auf dem Host.
SM_HTTPS_PORT=443
SM_HTTP_PORT=80
# Zeitzone der Container (Logs); die Spielregeln rechnen immer in Europe/Berlin.
TZ=Europe/Berlin
# Registry-Spiegel für Basis-Images, falls Docker Hub drosselt (z. B. mirror.gcr.io/library).
REGISTRY=docker.io/library
